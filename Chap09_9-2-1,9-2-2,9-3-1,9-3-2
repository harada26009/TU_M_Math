      "cell_type": "code",
      "source": [
        "# k-means法を使うためのインポート\n",
        "from sklearn.cluster import KMeans\n",
        "\n",
        "# データ取得のためのインポート\n",
        "from sklearn.datasets import make_blobs\n",
        "\n",
        "# サンプルデータ作成\n",
        "# 注意：make_blobsは２つの値を返すため、一方は使用しない「＿」で受け取る\n",
        "X, _ =make_blobs(random_state=10)\n",
        "\n",
        "# グラフ描画\n",
        "# colorのオプションで色付けができる\n",
        "import matplotlib.pyplot as plt\n",
        "plt.scatter(X[:,0],X[:,1],color='black')\n",
        "\n",
        "# KMeansクラスの初期化\n",
        "kmeans = KMeans(init='random',n_clusters=3, random_state=10, n_init=10)\n",
        "\n",
        "# クラスターの重心を計算\n",
        "kmeans.fit(X)\n",
        "\n",
        "# クラスター番号を予測\n",
        "y_pred = kmeans.predict(X)"
      ],
